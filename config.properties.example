# AIDoctor 本地配置模板
# 复制本文件为 config.properties 后填入本机真实信息（config.properties 已被 .gitignore 忽略，不会上传）。
# 格式：key=value，支持 # 或 // 注释，空行忽略。
# 优先级：环境变量 > config.properties > 内置默认值。

# ===== 数据库连接 =====
# 也可用环境变量 DB_URL 覆盖
DB_URL=jdbc:mysql://localhost:3306/ai_doctor?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=your_mysql_password

# ===== AI 大模型（AI 问诊，必填其一；启动脚本会从本文件注入为环境变量）=====
# 后端 src/Main.java 通过 System.getenv 读取，start_app.bat / start_app.ps1 会从 config.properties 注入
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ===== 药品识别 OCR（可选，不填则使用本地 OCR / 手动输入）=====
# 百度智能云 OCR：https://cloud.baidu.com/product/ocr
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 腾讯云 OCR：https://cloud.tencent.com/product/ocr
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou

# OCR 引擎偏好：auto（自动）/ baidu / tencent / local
OCR_ENGINE=auto
